-- Restore the archived version 1.0 in Studio Edit mode through execute_luau.
-- Current objects are moved into ServerStorage for rollback, not discarded.
assert(not game:GetService("RunService"):IsRunning(),"Stop the playtest before restoring")
local encoded=[====[]====]
local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup={}
for i=1,#alphabet do lookup[alphabet:sub(i,i)]=i-1 end
local padding=encoded:sub(-2)=="==" and 2 or (encoded:sub(-1)=="=" and 1 or 0)
local data=buffer.create(#encoded/4*3-padding)
local offset=0
for i=1,#encoded,4 do
    local a,b,c,d=lookup[encoded:sub(i,i)],lookup[encoded:sub(i+1,i+1)],lookup[encoded:sub(i+2,i+2)] or 0,lookup[encoded:sub(i+3,i+3)] or 0
    local bits=a*262144+b*4096+c*64+d
    if offset<buffer.len(data) then buffer.writeu8(data,offset,math.floor(bits/65536)%256) offset+=1 end
    if offset<buffer.len(data) then buffer.writeu8(data,offset,math.floor(bits/256)%256) offset+=1 end
    if offset<buffer.len(data) then buffer.writeu8(data,offset,bits%256) offset+=1 end
end
local package=game:GetService("SerializationService"):DeserializeInstancesAsync(data)[1]
assert(package:GetAttribute("Version")=="1.0","Unexpected snapshot")
local backup=Instance.new("Folder") backup.Name="BeforeRestoringV1_"..os.time() backup.Parent=game.ServerStorage
local targets={Workspace=workspace,ServerScriptService=game.ServerScriptService,ReplicatedStorage=game.ReplicatedStorage,
    StarterPlayerScripts=game.StarterPlayer.StarterPlayerScripts,StarterCharacterScripts=game.StarterPlayer.StarterCharacterScripts,
    StarterGui=game.StarterGui,Lighting=game.Lighting}
local restoredCamera
for name,target in targets do
    local originals=Instance.new("Folder") originals.Name=name originals.Parent=backup
    if name=="Lighting" then
        for _,item in target:GetChildren() do
            if item:IsA("PostEffect") or item:IsA("Atmosphere") then item.Parent=originals end
        end
    end
    local container=package:FindFirstChild(name)
    if container then
        for _,item in container:GetChildren() do
            local current=target:FindFirstChild(item.Name)
            if current then current.Parent=originals end
            item.Parent=target
            if name=="Workspace" and item:IsA("Camera") then restoredCamera=item end
        end
        for key,value in container:GetAttributes() do
            pcall(function() target[key]=value end)
        end
    end
end
if restoredCamera then workspace.CurrentCamera=restoredCamera end
package.Name="SnapshotMetadata" package.Parent=backup
game:GetService("ChangeHistoryService"):SetWaypoint("Restored Skyhop version 1.0")
return {restoredVersion="1.0",coins=#workspace.SkyhopObby.Coins:GetChildren(),rollback=backup:GetFullName()}
